{
  "name": "TerraCorridor Email - Approved inspection handoff",
  "nodes": [
    {
      "id": "email-1",
      "name": "Manual delivery check",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "email-2",
      "name": "Every five minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "email-3",
      "name": "Email delivery config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { enabled:false, from:'', to:'', maxPerRun:3 } }];"
      }
    },
    {
      "id": "email-4",
      "name": "Delivery enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.enabled === true && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test($json.from) && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test($json.to) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "email-5",
      "name": "Get queued approved orders",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "fWeMlbL9wQ5I7m3N",
          "cachedResultName": "corridor_work_orders"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "keyValue": "approved"
            },
            {
              "keyName": "delivery_state",
              "keyValue": "queued"
            }
          ]
        },
        "limit": "={{ $(\"Email delivery config\").first().json.maxPerRun }}"
      }
    },
    {
      "id": "email-6",
      "name": "Prepare inspection email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "\nconst cfg = $('Email delivery config').first().json;\nreturn $input.all().flatMap((item,i)=>{\n  const w=item.json;\n  if(w.status!=='approved'||w.delivery_state!=='queued'||!w.work_order_id)return [];\n  let facts=[];try{facts=JSON.parse(w.facts_json||'[]');}catch(_){}\n  return [{json:{\n    ...w,email_from:cfg.from,email_to:cfg.to,\n    email_subject:'[TerraCorridor] Approved inspection '+w.work_order_id,\n    email_body:[\n      'Approved inspection handoff',\n      'Work order: '+w.work_order_id,\n      'Segment: '+w.segment_id,\n      'Priority: '+w.priority,\n      'Approved by: '+(w.decided_by||'integrity manager'),\n      'Approved at: '+(w.decided_at||''),\n      '',w.summary||'','',\n      ...(Array.isArray(facts)?facts.filter(x=>typeof x==='string'&&!x.startsWith('Next step:')):[]),\n      '',\n      'Coordinator: review this order, import it into your maintenance system, and schedule the inspection.',\n      'This email is a handoff. No crew has been dispatched and no SAP/Maximo ticket has been created.'\n    ].join('\\n')\n  },pairedItem:{item:i}}];\n});"
      }
    },
