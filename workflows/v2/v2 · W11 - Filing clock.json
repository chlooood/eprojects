    {
      "parameters": {
        "jsCode": "// W11 filing clock. One row per segment that has a plan_due date.\n// Status: unverified if data_status is not exactly \"verified\" or plan_due is not a valid date,\n// overdue if past, due_soon if 60 days or less, otherwise open. Days are counted in America/Vancouver.\nconst zone = 'America/Vancouver';\nconst today = DateTime.now().setZone(zone).startOf('day');\nconst checkedAt = new Date().toISOString();\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  const segmentId = String(r.segment_id ?? '').trim();\n  const due = String(r.plan_due ?? '').trim();\n  if (!segmentId || !due) continue;\n  const dueDate = /^\\d{4}-\\d{2}-\\d{2}/.test(due) ? DateTime.fromISO(due.slice(0, 10), { zone }) : null;\n  const valid = !!(dueDate && dueDate.isValid);\n  const daysLeft = valid ? Math.round(dueDate.startOf('day').diff(today, 'days').days) : null;\n  let status;\n  if (!valid || String(r.data_status ?? '').trim() !== 'verified') status = 'unverified';\n  else if (daysLeft < 0) status = 'overdue';\n  else if (daysLeft <= 60) status = 'due_soon';\n  else status = 'open';\n  out.push({ json: {\n    segment_id: segmentId,\n    corridor_id: String(r.corridor_id ?? ''),\n    kind: 'cer_class_plan',\n    change_date: String(r.change_date ?? ''),\n    plan_due: due,\n    days_left: daysLeft,\n    status,\n    checked_at: checkedAt,\n  } });\n}\nreturn out;"
      },
